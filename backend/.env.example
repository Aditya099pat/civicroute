# Port the Express API listens on.
PORT=5000

# Google Gemini API key. Leave blank to run in verified-seed fallback mode
# (the app still works without AI). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model IDs. The primary is tried first, then the fallback.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Comma-separated list of allowed browser origins for CORS.
# Use * for open access during local development.
CORS_ORIGIN=http://localhost:5173

# Comma-separated allowlist of host suffixes the /api/verify-urls endpoint may
# contact. Only government domains are permitted by default (SSRF protection).
ALLOWED_VERIFY_HOSTS=.gov.in,.gov,.nic.in
